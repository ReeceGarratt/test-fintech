---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import SignUpForm from '../components/SignUpForm';

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<Layout title="Sign Up" description="Create your SwiftPay account and start sending money worldwide">
  <Navigation client:load baseUrl={baseUrl} currentPath={Astro.url.pathname} />
  
  <main class="main">
    <div class="auth-container">
      <div class="auth-content">
        <div class="auth-header">
          <h1 class="auth-title">Create your account</h1>
          <p class="auth-subtitle">Join 500,000+ users sending money worldwide</p>
        </div>
        
        <SignUpForm client:load baseUrl={baseUrl} />
        
        <div class="auth-footer">
          <p>Already have an account? <a href={`${base}login/`} class="auth-link">Log in</a></p>
        </div>
      </div>
      
      <div class="auth-side">
        <div class="auth-side-content">
          <div class="auth-features">
            <div class="auth-feature">
              <div class="auth-feature-icon">✓</div>
              <div class="auth-feature-text">
                <h3>Free to join</h3>
                <p>No monthly fees, ever</p>
              </div>
            </div>
            <div class="auth-feature">
              <div class="auth-feature-icon">✓</div>
              <div class="auth-feature-text">
                <h3>Secure transfers</h3>
                <p>Bank-level encryption</p>
              </div>
            </div>
            <div class="auth-feature">
              <div class="auth-feature-icon">✓</div>
              <div class="auth-feature-text">
                <h3>Fast delivery</h3>
                <p>Most transfers in minutes</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .main {
    min-height: 100vh;
    padding-top: 70px;
    display: flex;
    align-items: center;
  }
  
  .auth-container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .auth-content {
    max-width: 420px;
  }
  
  .auth-header {
    margin-bottom: 2rem;
  }
  
  .auth-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  
  .auth-subtitle {
    color: var(--text-secondary);
  }
  
  .auth-footer {
    margin-top: 2rem;
    text-align: center;
    color: var(--text-secondary);
  }
  
  .auth-link {
    color: var(--accent-primary);
    font-weight: 500;
    transition: color var(--transition-fast);
  }
  
  .auth-link:hover {
    color: var(--accent-hover);
  }
  
  .auth-side {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .auth-side-content {
    background: linear-gradient(135deg, rgba(0, 212, 170, 0.08) 0%, rgba(9, 132, 227, 0.05) 100%);
    border: 1px solid rgba(0, 212, 170, 0.15);
    border-radius: var(--radius-xl);
    padding: 3rem;
    width: 100%;
    max-width: 400px;
  }
  
  .auth-features {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .auth-feature {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  
  .auth-feature-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
    color: var(--bg-primary);
    border-radius: 50%;
    font-size: 0.875rem;
    font-weight: 600;
    flex-shrink: 0;
  }
  
  .auth-feature-text h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  
  .auth-feature-text p {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  
  @media (max-width: 900px) {
    .auth-container {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
    
    .auth-side {
      display: none;
    }
    
    .auth-content {
      max-width: 100%;
    }
  }
</style>
